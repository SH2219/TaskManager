DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/TaskManager

# App secrets
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# NVIDIA NIM (Gen AI task descriptions) — free key from https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional extra admin created on startup (in addition to admin@taskmanager.local)
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=your-password
# SEED_ADMIN_NAME=Your Name
